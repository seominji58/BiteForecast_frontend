{
  "expo": {
    "name": "입질예보",
    "slug": "biteforecast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "biteforecast",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.seominji58.biteforecast"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2C4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.seominji58.biteforecast",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2C4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "「내 주변 찾기」를 누를 때만 현재 위치로 가까운 낚시터를 찾습니다. 위치는 기기 안에서 거리 계산에만 쓰고 서버로 보내지 않습니다.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "낚시 기록과 커뮤니티 글에 첨부할 사진, 어종을 찾을 물고기 사진을 앨범에서 고르기 위해 사진 보관함에 접근합니다. 위치 정보는 서버에 저장하기 전에 지웁니다.",
          "cameraPermission": "잡은 물고기를 바로 찍어 낚시 기록·글에 올리거나 어종을 찾기 위해 카메라를 사용합니다. 위치 정보는 서버에 저장하기 전에 지웁니다.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "ios": {
            "defaultLaunchURL": "http://seominjiui-MacBookAir.local:8081"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
