# 복사해서 .env 로 사용: cp .env.example .env
# 실기기(Expo Go)에서는 localhost 대신 개발 PC 의 LAN IP 를 넣는다 (macOS: ipconfig getifaddr en0)
# 주의: EXPO_PUBLIC_ 값은 앱에 그대로 포함된다. 공공 API 키 같은 비밀값은 절대 넣지 않는다 (NFR-03)
# 배포 서버(Fly.io): https://biteforecast-api.fly.dev/api/v1
# 로컬 서버: http://127.0.0.1:8001/api/v1 (실기기는 Mac 의 IP, 예 http://192.168.0.10:8001/api/v1)
EXPO_PUBLIC_API_URL=https://biteforecast-api.fly.dev/api/v1

# 구글 로그인 (개발용 앱·배포 앱에서만 동작, Expo Go 불가). 구글 클라우드 콘솔 → OAuth 클라이언트 ID
# 웹 애플리케이션 유형 ID (서버 GOOGLE_CLIENT_IDS 에도 넣는다)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS 유형 ID (번들 ID com.seominji58.biteforecast). 넣으면 다음 빌드부터 구글 로그인 URL 스킴이 등록된다
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
